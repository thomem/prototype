/* Layout: one phone-width column (max 560px) of booklet "pages" — tile cover, cream text bands, navy panels, terracotta chapter covers — with a fixed tab bar. Single light look, taken from the printed booklet. */
:root{
  --cream:#FBF7F0; --sand:#F2E8D8; --line:#E4D7C2;
  --navy:#173A5E; --navy-deep:#0F2742; --ink:#2C2A27; --muted:#625D55;
  --terra:#C46F48; --terra-ink:#A04F2B; --ochre:#E2A62A; --sage:#DDE5DF; --sage-line:#C3CFC6;
  --on-dark:#FBF7F0; --on-dark-muted:#C9D3DE;
  --display:"Cormorant Garamond", "Cormorant", Georgia, "Times New Roman", serif;
  --body:"Karla", "Helvetica Neue", Arial, sans-serif;
  --tabh:64px;
  --sea:#D6E6E7;
  --sage-bg:linear-gradient(rgba(224,232,226,.86),rgba(224,232,226,.86)), url(data:image/webp;base64,) center/cover;
  color-scheme:light;
}
html[lang="ar"]{--display:"Noto Naskh Arabic", "Amiri", serif; --body:"Noto Sans Arabic", Tahoma, sans-serif}
html[lang="he"]{--display:"Frank Ruhl Libre", "David", serif; --body:"Heebo", Arial, sans-serif}
html[lang="zh"]{--display:"Noto Serif SC", "Songti SC", serif; --body:"Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{background:var(--sand)}
body{background:var(--sand); color:var(--ink); font-family:var(--body); font-size:16px; line-height:1.55; -webkit-font-smoothing:antialiased; -webkit-tap-highlight-color:transparent}
body::before{content:""; position:fixed; inset:0 0 auto; height:env(safe-area-inset-top,0px); z-index:30; background:var(--cream)}
a{color:inherit}
button{font:inherit; color:inherit}
:focus-visible{outline:2px solid var(--ochre); outline-offset:2px}
.app{max-width:560px; margin:0 auto; background:var(--cream); min-height:100vh; position:relative; box-shadow:0 0 0 1px var(--line)}
.wrap{padding-left:max(18px, env(safe-area-inset-left,0px)); padding-right:max(18px, env(safe-area-inset-right,0px))}
.eyebrow{font-family:var(--body); font-size:11px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:var(--terra-ink)}
html[lang="ar"] .eyebrow, html[lang="he"] .eyebrow, html[lang="zh"] .eyebrow{letter-spacing:.04em; font-size:12px}
h1,h2,h3,h4{font-family:var(--display); font-weight:400; color:var(--navy); margin:0; text-wrap:balance; line-height:1.15}
p{margin:0}
bdi.ltr{direction:ltr; unicode-bidi:isolate}

/* ---------- Language picker ---------- */
#picker{min-height:100vh; display:flex; flex-direction:column; background:var(--navy-deep)}
.pk-top{position:relative; background:url(data:image/webp;base64,) center/cover; padding-block:22px 34px; color:var(--on-dark); display:flex; flex-direction:column; gap:4px}
.pk-top::after{content:""; position:absolute; inset:0; background:rgba(12,32,55,.5)}
.pk-top > *{position:relative; z-index:1}
.pk-top .eyebrow{color:var(--on-dark); font-size:10px}
.pk-title{font-family:"Cormorant Garamond", Georgia, serif; font-size:34px; line-height:1; color:var(--on-dark)}
.pk-title em{color:var(--ochre); font-style:italic}
.pk-hello{margin-top:22px; font-size:12.5px; color:var(--muted); line-height:1.7; text-align:center}
.pk-body{flex:1; background:var(--cream); padding-block:24px 36px; border-radius:22px 22px 0 0; margin-top:-18px; position:relative; z-index:2}
.pk-wifi{width:100%; margin-top:14px; display:flex; align-items:center; gap:14px; min-height:68px; padding:12px 16px; border-radius:14px; border:1px solid var(--sage-line); background:var(--sage-bg); cursor:pointer; text-align:start; color:var(--navy)}
.qwifi{grid-column:1/-1; margin-top:0}
.pk-wifi-ico{width:44px; height:44px; border-radius:50%; background:var(--navy); color:var(--on-dark); display:grid; place-items:center; flex:none}
.pk-wifi-ico .ico{width:22px; height:22px}
.pk-wifi-txt{flex:1; min-width:0; display:flex; flex-direction:column}
.pk-wifi-txt b{font-family:"Cormorant Garamond", Georgia, serif; font-weight:500; font-size:22px; line-height:1.1}
.pk-wifi-txt small{font-size:12px; color:var(--muted)}
.wqr{display:flex; flex-direction:column; align-items:center; gap:10px; padding:16px; background:#fff; border:1px solid var(--line); border-radius:16px}
.wqr img{width:200px; height:200px; image-rendering:pixelated; -webkit-touch-callout:default; border-radius:6px}
.wqr p{font-size:14px; text-align:center; color:var(--ink); max-width:30ch}
.wqr p b{color:var(--navy)}
.wsteps{display:flex; flex-direction:column; gap:8px; margin-top:14px}
.wsteps div{display:grid; grid-template-columns:28px 1fr; gap:10px; align-items:start; font-size:14px}
.wsteps i{font-style:normal; width:28px; height:28px; border-radius:50%; background:var(--ochre); color:#3A2A05; font-weight:700; display:grid; place-items:center; font-size:13px}
.pk-body h2{font-family:"Cormorant Garamond", Georgia, serif; font-size:28px; margin-bottom:4px}
.pk-sub{color:var(--muted); font-size:13px; margin-bottom:20px}
.langs{display:grid; grid-template-columns:1fr 1fr; gap:10px}
.lang{display:flex; flex-direction:column; align-items:flex-start; gap:2px; min-height:72px; padding:14px 16px; background:#fff; border:1px solid var(--line); border-radius:14px; cursor:pointer; text-align:start; position:relative; transition:border-color .15s, transform .15s}
.lang:active{transform:scale(.98)}
.lang:hover{border-color:var(--terra)}
.lang b{font-family:var(--display); font-weight:500; font-size:22px; color:var(--navy); line-height:1.1}
.lang span{font-size:12px; color:var(--muted)}
.lang[data-dir="rtl"]{direction:rtl; text-align:right; align-items:flex-end}
.lang.suggest{border-color:var(--ochre); box-shadow:0 0 0 1px var(--ochre)}
.lang.suggest::after{content:""; position:absolute; top:12px; inset-inline-end:12px; width:8px; height:8px; border-radius:50%; background:var(--ochre)}
.lang[data-dir="rtl"].suggest::after{inset-inline-end:auto; left:12px}
.lang[data-l="ar"] b{font-family:"Noto Naskh Arabic", serif}
.lang[data-l="he"] b{font-family:"Frank Ruhl Libre", serif}
.lang[data-l="zh"] b{font-family:"Noto Serif SC", serif}
.pk-foot{margin-top:28px; display:flex; justify-content:center; gap:18px; opacity:.9}

/* ---------- Header ---------- */
.top{position:sticky; top:env(safe-area-inset-top,0px); z-index:20; background:rgba(251,247,240,.94); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; gap:12px; padding-block:8px; min-height:56px}
.brand{background:none; border:0; padding:6px 0; cursor:pointer; font-family:"Cormorant Garamond", Georgia, serif; font-size:22px; color:var(--navy); font-weight:500; white-space:nowrap}
.brand i{color:var(--terra-ink)}
.langbtn{display:inline-flex; align-items:center; gap:6px; min-height:40px; padding:0 14px; border-radius:999px; border:1px solid var(--line); background:#fff; cursor:pointer; font-size:13px; font-weight:700; letter-spacing:.06em; color:var(--navy)}
.langbtn svg{width:16px; height:16px}

/* ---------- Generic ---------- */
.ico{width:18px; height:18px; flex:none; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round}
.zig{height:12px; background:linear-gradient(135deg, var(--cream) 25%, transparent 25%) -6px 0/12px 12px, linear-gradient(225deg, var(--cream) 25%, transparent 25%) -6px 0/12px 12px, repeating-linear-gradient(90deg, var(--terra) 0 12px, var(--ochre) 12px 24px)}
.scallop{height:22px; background:radial-gradient(circle at 50% 100%, var(--cream) 21px, transparent 22px) 0 0/80px 22px repeat-x}
.palm{display:inline-block; width:var(--w,46px); aspect-ratio:300/353; background:var(--c,var(--navy)); -webkit-mask:url(data:image/png;base64,) center/contain no-repeat; mask:url(data:image/png;base64,) center/contain no-repeat}
.palms{display:flex; align-items:flex-end; gap:18px; justify-content:center; padding-block:28px 6px}

/* ---------- Home ---------- */
.hero{position:relative; background:url(data:image/webp;base64,) center/cover; color:var(--on-dark); padding-block:40px 34px}
.hero::before{content:""; position:absolute; inset:0; background:rgba(12,32,55,.5)}
.hero > *{position:relative}
.hero .eyebrow{color:var(--on-dark)}
.hero h1{color:var(--on-dark); font-size:46px; line-height:1; margin-top:14px}
.hero h1 em{display:block; font-family:"Cormorant Garamond", Georgia, serif; color:var(--ochre); font-style:italic; font-size:52px; margin-top:4px}
.hero p{margin-top:16px; max-width:34ch; font-size:15px; color:var(--on-dark)}
.hosts-mini{margin-top:22px; display:flex; flex-direction:column; gap:2px}
.hosts-mini .eyebrow{color:var(--ochre)}
.hosts-mini b{font-family:var(--display); font-weight:400; font-size:24px}

.quick{padding-block:20px 8px; display:grid; grid-template-columns:1fr 1fr; gap:10px}
.qcard{background:#fff; border:1px solid var(--line); border-radius:14px; padding:14px; display:flex; flex-direction:column; gap:6px; min-width:0; text-decoration:none; cursor:pointer; text-align:start}
.qcard.wide{grid-column:1/-1}
.qcard .eyebrow{display:flex; align-items:center; gap:6px; font-size:10px}
.qcard .eyebrow .ico{width:15px; height:15px}
.qcard b{font-family:var(--display); font-weight:500; font-size:20px; color:var(--navy); line-height:1.15}
.qcard small{font-size:13px; color:var(--muted)}
.wifi{background:var(--sage-bg); border-color:var(--sage-line)}
.wifi-row{display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:4px}
.wifi-row div{min-width:0}
.wifi-row span{display:block; font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.12em}
.mono{font-family:ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size:17px; color:var(--navy); font-weight:600; word-break:break-all}
.copybtn{display:inline-flex; align-items:center; justify-content:center; gap:6px; min-height:44px; padding:0 16px; border-radius:999px; border:0; background:var(--navy); color:var(--on-dark); font-size:14px; font-weight:700; cursor:pointer; align-self:flex-start; margin-top:6px}
.copybtn.ok{background:#2E6B4F}
.sosbar{display:flex; align-items:center; justify-content:space-between; gap:12px; background:var(--terra) url(data:image/webp;base64,) center/cover; color:#fff; border-radius:14px; padding:12px 16px; text-decoration:none; grid-column:1/-1}
.sosbar b{font-family:var(--display); font-size:34px; font-weight:500; line-height:1}
.sosbar span{font-size:13px; font-weight:700; letter-spacing:.14em; text-transform:uppercase}

.band{padding-block:34px}
.band.sand{background:var(--sand)}
.band h2{font-size:34px; margin-top:8px}
.band p + p{margin-top:12px}
.band .txt{margin-top:14px; color:var(--ink)}
.note{border-radius:12px; padding:16px 18px; display:flex; flex-direction:column; gap:6px}
.note .eyebrow{font-size:10.5px}
.note.terra{background:var(--terra) url(data:image/webp;base64,) center/cover; color:#fff}
.note.terra .eyebrow{color:#fff}
.note.terra .act{background:#fff; border-color:#fff; color:var(--terra-ink); font-weight:700; white-space:normal; text-overflow:clip; min-height:44px; padding-block:8px; line-height:1.3}
.note.terra .act .ico{flex:none}
.note.navy .act{background:#fff; border-color:#fff; color:var(--navy)}
.note.navy{background:var(--navy-deep) url(data:image/webp;base64,) center/cover; color:var(--on-dark)}
.note.navy .eyebrow{color:var(--ochre)}
.note.sand{background:var(--sand); border:1px solid var(--line)}
.note.gold{background:#fff; border:1px solid var(--line); border-inline-start:3px solid var(--ochre)}
.note p + p{margin-top:8px}

.area{background:var(--navy-deep) url(data:image/webp;base64,) center/cover; color:var(--on-dark); border-radius:16px; padding:22px 18px; margin-top:18px; position:relative; overflow:hidden}
.area::after{content:""; position:absolute; width:120px; height:120px; border-radius:50%; background:var(--ochre); opacity:.22; top:-40px; inset-inline-end:-30px}
.area .eyebrow{color:var(--ochre)}
.area h3{color:var(--on-dark); font-size:26px; margin-top:6px}
.area > p{font-size:13.5px; color:var(--on-dark-muted); margin-top:6px}
.dist{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:rgba(255,255,255,.14); border-radius:10px; overflow:hidden; margin-top:18px}
.dist div{background:rgba(15,39,66,.82); padding:12px 10px; min-width:0}
.dist b{display:block; font-family:var(--display); font-weight:500; font-size:19px; color:var(--on-dark)}
.dist span{font-size:12px; color:var(--ochre)}
.area small{display:block; margin-top:14px; font-size:12px; color:var(--on-dark-muted); font-style:italic}

.index{background:var(--navy-deep) url(data:image/webp;base64,) center/cover; color:var(--on-dark); padding-block:34px 30px}
.index-head{display:flex; align-items:baseline; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,.22); padding-bottom:12px}
.index-head h2{color:var(--on-dark); font-size:38px}
.index-head .eyebrow{color:var(--ochre)}
.toc{list-style:none; margin:14px 0 0; padding:0; display:flex; flex-direction:column; gap:8px}
.toc button{width:100%; display:grid; grid-template-columns:30px 1fr 38px; align-items:center; gap:10px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.2); border-radius:14px; padding:12px 12px; min-height:68px; cursor:pointer; text-align:start; color:var(--on-dark); box-shadow:0 2px 0 rgba(0,0,0,.18); transition:transform .12s, background .12s}
.toc button:hover{background:rgba(255,255,255,.14)}
.toc button:active{transform:scale(.98); background:rgba(255,255,255,.18)}
.toc .go{width:38px; height:38px; border-radius:50%; background:var(--ochre); color:var(--navy-deep); display:grid; place-items:center}
.toc .go .ico{width:20px; height:20px; stroke-width:2.4; opacity:1}
.tap-hint{display:flex; align-items:center; gap:8px; margin-top:14px; font-size:13px; color:var(--ochre)}
.tap-hint .ico{width:16px; height:16px}
.toc .n{font-family:var(--display); font-size:17px; color:var(--ochre)}
.toc b{display:block; font-family:var(--display); font-weight:500; font-size:21px; line-height:1.2}
.toc small{display:block; font-size:11.5px; color:var(--on-dark-muted); margin-top:2px; line-height:1.4}
html[dir="rtl"] .chev{transform:scaleX(-1)}

.leopard{display:block; width:150px; max-width:45%; height:auto}

/* ---------- Chapter ---------- */
.cover{position:relative; background:var(--terra) url(data:image/webp;base64,) center/cover; color:#fff; padding-block:36px 0; overflow:hidden}
.cover-num{font-size:12px; font-weight:700; letter-spacing:.2em; color:#fff; opacity:.9}
.cover h1{color:#fff; font-size:44px; margin-top:6px}
.cover p{margin-top:12px; font-size:15px; max-width:32ch; color:#FFF6EC}
.cover-art{display:flex; align-items:flex-end; justify-content:flex-end; gap:14px; margin-top:20px; min-height:110px}
.cover-art .leopard{width:140px}
.cover .scallop{margin-inline:calc(-1 * max(18px, env(safe-area-inset-left,0px)))}
.content{padding-block:12px 28px; display:flex; flex-direction:column; gap:16px}
.content > h2{font-size:32px; margin-top:22px; padding-bottom:8px; border-bottom:1px solid var(--line)}
.content > h3.city{font-size:27px; margin-top:12px; color:var(--navy)}
.content > .sub{margin-top:6px}
.lead{font-family:var(--display); font-style:italic; font-size:22px; line-height:1.35; color:var(--navy)}
.prose p + p{margin-top:12px}
.cards{display:grid; grid-template-columns:1fr; gap:10px}
.card{background:#fff; border:1px solid var(--line); border-radius:14px; padding:16px; display:flex; flex-direction:column; gap:7px; min-width:0}
.card.sage{background:var(--sage-bg); border-color:var(--sage-line)}
.card h4{font-size:22px; font-weight:500}
.card p{font-size:14.5px; color:var(--ink)}
.card .addr{font-size:13px; color:var(--muted)}
.badge{align-self:flex-start; font-size:10px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; background:var(--ochre); color:#3A2A05; padding:4px 8px; border-radius:4px}
.acts{display:flex; flex-wrap:wrap; gap:8px; margin-top:4px}
.act{display:inline-flex; align-items:center; gap:7px; min-height:40px; padding:0 13px; border-radius:999px; border:1px solid var(--line); background:var(--cream); font-size:13.5px; font-weight:500; color:var(--navy); text-decoration:none; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.act .ico{width:16px; height:16px}
.act.tel{background:var(--navy); border-color:var(--navy); color:var(--on-dark); font-weight:700}
.act:active{transform:scale(.97)}
.feature{background:var(--terra) url(data:image/webp;base64,) center/cover; color:#fff; border-radius:14px; padding:18px; display:flex; flex-direction:column; gap:8px}
.feature h4{color:#fff; font-size:26px}
.feature .addr{color:#FFE9D8; font-size:13px}
.feature .act{background:rgba(255,255,255,.14); border-color:rgba(255,255,255,.35); color:#fff}
.feature .act.tel{background:#fff; color:var(--terra-ink)}
.list{display:flex; flex-direction:column; background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden}
.list.navy{background:var(--navy-deep) url(data:image/webp;base64,) center/cover; border-color:var(--navy-deep); color:var(--on-dark)}
.li{padding:14px 16px; border-bottom:1px solid var(--line); display:flex; flex-direction:column; gap:4px}
.list.navy .li{border-color:rgba(255,255,255,.14)}
.li:last-child{border-bottom:0}
.li h4{font-size:20px; font-weight:500}
.list.navy h4{color:var(--on-dark)}
.li p{font-size:14px}
.list.navy p{color:var(--on-dark-muted)}
.li .acts{margin-top:2px}
.list.navy .act{background:transparent; border-color:rgba(255,255,255,.3); color:var(--on-dark)}
.rows{display:flex; flex-direction:column}
.row{display:flex; flex-direction:column; gap:6px; padding-block:16px; border-bottom:1px solid var(--line)}
.row:first-child{padding-top:4px}
.row h4{font-size:21px; font-weight:500}
.row .note{margin-top:6px}
.facts{display:grid; grid-template-columns:1fr; gap:10px}
.fact{background:var(--sage-bg); border:1px solid var(--sage-line); border-radius:12px; padding:14px 16px; display:flex; flex-direction:column; gap:5px}
.fact .eyebrow{color:var(--terra-ink)}
.fact p{font-size:14.5px}
.links{display:flex; flex-direction:column; gap:8px}
.link{display:flex; align-items:center; gap:12px; background:#fff; border:1px solid var(--line); border-radius:12px; padding:12px 14px; min-height:56px; text-decoration:none; min-width:0}
.link > span{display:flex; flex-direction:column; min-width:0; flex:1}
.link small{font-size:10.5px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--terra-ink)}
.link b{font-weight:500; color:var(--navy); font-size:14.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.link .ico{color:var(--terra-ink)}
.sos{display:grid; grid-template-columns:repeat(3,1fr); gap:8px}
.sos a{display:flex; flex-direction:column; justify-content:space-between; gap:6px; min-height:84px; background:var(--sage-bg); border:1px solid var(--sage-line); border-radius:12px; padding:10px 12px; text-decoration:none; min-width:0}
.sos a:first-child{background:var(--terra) url(data:image/webp;base64,) center/cover; border-color:var(--terra); color:#fff}
.sos a:first-child small{color:#fff}
.sos small{font-size:9.5px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--terra-ink); line-height:1.25}
.sos b{font-family:var(--display); font-size:32px; font-weight:500; line-height:1}
.addrcard{background:var(--sage-bg); border:1px solid var(--sage-line); border-radius:14px; padding:16px; display:flex; flex-direction:column; gap:6px}
.addrcard address{font-style:normal; font-family:var(--display); font-size:22px; color:var(--navy); line-height:1.25}
.week{display:grid; grid-template-columns:1fr; gap:6px}
.day{display:grid; grid-template-columns:96px 1fr; align-items:center; gap:10px; background:#fff; border:1px solid var(--line); border-radius:10px; padding:10px 12px; min-height:48px}
.day b{font-weight:700; font-size:13px; color:var(--navy)}
.day span{display:flex; align-items:center; gap:8px; font-size:14px}
.day i{width:12px; height:12px; border-radius:50%; flex:none}
.day.today{border-color:var(--navy); box-shadow:0 0 0 1px var(--navy)}
.day em{font-style:normal; margin-inline-start:auto; font-size:10px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; background:var(--navy); color:var(--on-dark); padding:3px 7px; border-radius:4px}
.day.none span{color:var(--muted)}
.bins{display:grid; grid-template-columns:1fr; gap:10px}
.bin{background:#fff; border:1px solid var(--line); border-radius:12px; padding:14px 16px; border-top:4px solid var(--c)}
.bin h4{font-size:20px; font-weight:500}
.bin p{font-size:14px; margin-top:4px}
.bin p.x{color:var(--muted); font-size:13px}
.bin p.x b{color:var(--terra-ink)}
.pager{display:grid; grid-template-columns:1fr 1fr; gap:10px; padding-block:6px 30px}
.pager button{display:flex; flex-direction:column; gap:3px; min-height:72px; padding:12px 14px; background:var(--sand); border:1px solid var(--line); border-radius:12px; cursor:pointer; text-align:start; min-width:0}
.pager button.next{text-align:end; align-items:flex-end; background:var(--navy); color:var(--on-dark); border-color:var(--navy)}
.pager small{font-size:10.5px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--terra-ink)}
.pager .next small{color:var(--ochre)}
.pager b{font-family:var(--display); font-weight:500; font-size:18px; line-height:1.2; color:inherit}
