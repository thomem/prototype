  const saved=store.get('cm-lang'); const nav=((navigator.language||'en').slice(0,2)).toLowerCase();
  const sug=saved||(LANGS.some(l=>l.c===nav)?nav:null);
  $('#langs').innerHTML=LANGS.map(l=>`<button type="button" class="lang${l.c===sug?' suggest':''}" data-l="${l.c}" data-dir="${l.rtl?'rtl':'ltr'}" lang="${l.c}"><b>${l.n}</b><span>${l.s}</span></button>`).join('');
  ['ar','he','zh'].forEach(loadFont);
})();

/* sheets */
const sheet=$('#sheet');
function openSheet(kind){
  let h='';
  if(kind==='wifi') h=`<div class="sheet-head"><h2>${esc(t('ui.wifi'))}</h2><button class="xbtn" type="button" data-close aria-label="${esc(t('ui.close'))}">${ico('x')}</button></div>${wifiJoin()}`;
  if(kind==='guide') h=`<div class="sheet-head"><h2>${esc(t('ui.chapters'))}</h2><button class="xbtn" type="button" data-close aria-label="${esc(t('ui.close'))}">${ico('x')}</button></div>${tocHTML()}`;
  if(kind==='hosts') h=`<div class="sheet-head"><h2>Marco &amp; Giulia</h2><button class="xbtn" type="button" data-close aria-label="${esc(t('ui.close'))}">${ico('x')}</button></div>${hostsBlock()}<p class="hint">${esc(t('ui.contactHint'))}</p><div class="sos" style="margin-top:16px">${R.sos().replace(/^<div class="sos">|<\/div>$/g,'')}</div>`;
  $('#sheetIn').innerHTML='<div class="grab"></div>'+h;
  lockScroll();
  try{sheet.showModal()}catch(e){sheet.setAttribute('open','')}
  sheet.scrollTop=0;
}
let lockY=0;
function lockScroll(){ if(document.body.classList.contains('locked')) return; lockY=window.scrollY; document.body.style.top=(-lockY)+'px'; document.body.classList.add('locked'); }
function unlockScroll(){ if(!document.body.classList.contains('locked')) return; document.body.classList.remove('locked'); document.body.style.top=''; window.scrollTo(0,lockY); }
function closeSheet(){ if(sheet.open){try{sheet.close()}catch(e){sheet.removeAttribute('open')}} unlockScroll(); }
sheet.addEventListener('close',unlockScroll);
sheet.addEventListener('click',e=>{ if(e.target===sheet) closeSheet(); });

let tt;
function toast(msg){const el=$('#toast'); el.textContent=msg; el.classList.add('show'); clearTimeout(tt); tt=setTimeout(()=>el.classList.remove('show'),1600);}
async function copy(text,btn){
  let ok=false;
  try{await navigator.clipboard.writeText(text); ok=true;}catch(e){
    try{const ta=document.createElement('textarea'); ta.value=text; ta.setAttribute('readonly',''); ta.style.position='fixed'; ta.style.opacity='0'; document.body.appendChild(ta); ta.select(); ok=document.execCommand('copy'); ta.remove();}catch(_){}
  }
  toast(ok?(t('ui.copied')+' · '+text):text);
  if(ok&&btn){btn.classList.add('ok'); setTimeout(()=>btn.classList.remove('ok'),1400);}
}

document.addEventListener('click',e=>{
  const el=e.target.closest('button,[data-copy]'); if(!el) return;
  if(el.dataset.l){ setLang(el.dataset.l); return; }
  if(el.dataset.copy!==undefined){ e.preventDefault(); copy(el.dataset.copy,el); return; }
  if(el.dataset.go!==undefined){ go(el.dataset.go); return; }
  if(el.hasAttribute('data-close')){ closeSheet(); return; }
  if(el.dataset.tab){ const k=el.dataset.tab; if(k==='home'||k==='map') go(k); else openSheet(k); return; }
  if(el.dataset.cat){ FILTER=el.dataset.cat; applyFilter(true); return; }
  if(el.dataset.map){ if(!MAP) return; if(el.dataset.map==='home') MAP.setView(HOME,14.5); else fitPins(visiblePins()); return; }
  if(el.dataset.pin){ const p=PINS.find(x=>x[0]===el.dataset.pin); if(MAP&&p){ document.getElementById('map').scrollIntoView({behavior:'smooth',block:'center'}); MAP.setView([p[3],p[4]],Math.max(MAP.getZoom(),15)); setTimeout(()=>MARK[p[0]].openPopup(),350);} return; }
  if(el.id==='brand'){ go('home'); return; }
  if(el.id==='langbtn'){ showPicker(); return; }
  if(el.id==='pkwifi'){ openSheet('wifi'); return; }
});

/* boot: #fr, #en … opens that language directly (useful for a QR code per language) */
const h=(location.hash||'').slice(1).toLowerCase();
(async()=>{ try{ if(!EN['ui.home']) EN=await getJSON('en'); }catch(e){}
  if(LANGS.some(l=>l.c===h)) setLang(h); else { showPicker(); if(h==='wifi') openSheet('wifi'); } })();
})();
